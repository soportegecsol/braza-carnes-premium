# Copia este archivo a .env si quieres sobreescribir los valores por defecto.
# El servidor funciona sin .env (usa estos mismos valores por defecto).

# Puerto del servidor (backend + frontend en el mismo puerto)
PORT=3000

# Ruta del archivo SQLite (por defecto: backend/data/braza.db)
# SQLITE_FILE=./data/braza.db

# Pasarela de pagos (Bold) — mientras no haya credenciales reales,
# el servicio funciona en modo mock automáticamente (ver src/services/bold.js)
BOLD_API_KEY=

# Para migrar a Postgres en el futuro (no implementado todavía,
# ver backend/README.md sección "Qué NO está implementado")
# DATABASE_URL=postgresql://usuario:password@localhost:5432/braza
